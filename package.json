{
  "name": "time-tracker",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "build": "vite build",
    "build:mobile": "cross-env CAPACITOR_BUILD=true vite build",
    "cap:sync": "npm run build:mobile && npx cap sync",
    "cap:android": "npx cap open android",
    "cap:ios": "npx cap open ios",
    "icons:generate": "node scripts/generate-pwa-icons.mjs",
    "deploy": "gh-pages -d dist",
    "preview": "vite preview --host 0.0.0.0 --port 3000"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@typescript-eslint/parser": "^8.68.0",
    "cross-env": "^7.0.3",
    "eslint": "^9.39.5",
    "eslint-plugin-vue": "^9.33.0",
    "fake-indexeddb": "^6.2.5",
    "gh-pages": "^6.3.0",
    "globals": "^15.15.0",
    "jsdom": "^24.1.0",
    "vite": "^5.4.21",
    "vitest": "^1.6.0",
    "vue-eslint-parser": "^9.4.3"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.1",
    "@capacitor/cli": "^6.2.1",
    "@capacitor/core": "^6.2.1",
    "@capacitor/geolocation": "6",
    "@capacitor/ios": "^6.2.1",
    "@googlemaps/js-api-loader": "^2.1.3",
    "d3": "^7.9.2",
    "vite-plugin-pwa": "^0.21.1"
  }
}
